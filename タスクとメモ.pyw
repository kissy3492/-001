const BACKGROUNDS=[['library','夜の書庫',1],['hearth','琥珀の談話室',5],['forest','翡翠の魔法林',6],['clouds','雲海の天空城',7],['snowtown','雪灯りの魔法街',8]];
const Backgrounds={saved:'library',wanted:'library',busy:false};
function applyBackground(key){
 document.body.style.backgroundImage=`url("${base}art/${key}")`;
 document.body.dataset.background=key;
}
function acceptBackground(value){
 const key=BACKGROUNDS.some(([id])=>id===value)?value:'library';
 Backgrounds.saved=Backgrounds.wanted=key;applyBackground(key);
}
function updateBackgroundPicker(){
 for(const button of $('background-grid').children){
  const chosen=button.dataset.background===Backgrounds.saved;
  const pending=Backgrounds.busy&&button.dataset.background===Backgrounds.wanted&& !chosen;
  button.setAttribute('aria-pressed',String(chosen));
  button.classList.toggle('pending',pending);
  button.querySelector('.background-check').hidden=!chosen;
  button.querySelector('.background-state').textContent=pending?'変更中…':chosen?'選択中':'';
 }
}
async function chooseBackground(key){
 if(!BACKGROUNDS.some(([id])=>id===key))return;
 Backgrounds.wanted=key;
 if(Backgrounds.busy){updateBackgroundPicker();return}
 Backgrounds.busy=true;$('background-error').hidden=true;updateBackgroundPicker();
 try{
  // Serialize saves so rapid selections cannot leave an older preference behind.
  while(Backgrounds.saved!==Backgrounds.wanted){
   const next=Backgrounds.wanted;
   try{
    const image=new Image();image.src=base+'art/'+next;await image.decode();
    if(next!==Backgrounds.wanted)continue;
    await api('background',{value:next});
    Backgrounds.saved=next;applyBackground(next);updateBackgroundPicker();
   }catch(error){
    if(next!==Backgrounds.wanted)continue;
    Backgrounds.wanted=Backgrounds.saved;
    $('background-error').textContent='背景を変更できませんでした。もう一度選んでください。';$('background-error').hidden=false;
    if(!$('background-dialog').open)toast('背景を変更できませんでした。',null,true);
    break;
   }
  }
 }finally{Backgrounds.busy=false;updateBackgroundPicker()}
}
$('background-btn').onclick=()=>{
 $('menu').hidden=true;
 if(!$('background-grid').children.length){
  $('background-grid').innerHTML=BACKGROUNDS.map(([key,label,number])=>`<button type="button" class="background-choice" data-background="${key}" aria-label="${label}" aria-pressed="false"><span class="background-picture"><span class="background-number">${String(number).padStart(2,'0')}</span><img src="${base}art/${key}-thumb" alt="" width="480" height="270"><span class="background-check" hidden>${svg('check')}</span></span><span class="background-caption"><span>${label}</span><span class="background-state"></span></span></button>`).join('');
 }
 updateBackgroundPicker();$('background-dialog').showModal();
 $('background-grid').querySelector('[aria-pressed="true"]')?.focus({preventScroll:true});
};
$('background-grid').onclick=e=>{const b=e.target.closest('[data-background]');if(b)chooseBackground(b.dataset.background)};
$('background-close').onclick=()=>$('background-dialog').close();
$('background-dialog').addEventListener('close',()=>$('menu-btn').focus({preventScroll:true}));
$('background-dialog').addEventListener('click',e=>{
 if(e.target!==e.currentTarget)return;
 const r=e.currentTarget.getBoundingClientRect();
 if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)e.currentTarget.close();
