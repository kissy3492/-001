// One field model drives capture, comparisons, and resuming an editor.
const taskEdits=new Map();
function taskValues(row){
 const stage=row.stage||'作業前',waiting=stage==='相手待ち';
 return {title:row.title||'',detail:row.detail||'',due_date:row.due_date||'',due_time:row.due_time||'',stage,
  focus:stage!=='完了'&&(row.focus!==undefined?!!row.focus:!!row.focus_date),
  waiting_kind:row.waiting_kind||'依頼中',waiting_to:row.waiting_to||'',
  waiting_since:waiting?(row.waiting_since||S.today):'',followup_date:waiting?(row.followup_date||''):''};
}
function sameTaskValues(a,b){return JSON.stringify(taskValues(a))===JSON.stringify(taskValues(b))}
function readTaskEditor(){
 const d=S.dialog;if(!d)return null;
 return {...d,...taskValues({...d,title:$('dialog-title').value,detail:$('dialog-detail').value,
  waiting_to:$('waiting-to').value,waiting_since:$('waiting-since').value})};
}
function syncNewTaskDraft(){
 if(!$('task-dialog').open||taskSaving||S.dialog?.id||S.dialog?.consumeDraft===false)return;
 const values=taskValues(readTaskEditor());
 if(!sameTaskValues(S.draft,values)){S.draft={...S.draft,...values};dirtyDraft();updateQuick()}
}
function activeTaskChanged(){const d=readTaskEditor();return !!d&&(d.consumeDraft===false||!sameTaskValues(d,d.initial||{}))}
function updateTaskEditStatus(){
 if(!$('task-dialog').open)return;
 syncNewTaskDraft();
 const d=S.dialog,changed=activeTaskChanged();
 $('dialog-cancel').textContent=changed?'変更を破棄':'閉じる';
 $('task-edit-status').textContent=d.id||d.consumeDraft===false?(changed?'未保存':''):'下書き';
}
function rebaseTaskEdit(id,row){
 const draft=taskEdits.get(id);if(!draft)return;
 if(!row||row.deleted){taskEdits.delete(id);updateTaskResume();return}
 const original=taskValues(draft.initial),edited=taskValues(draft),current=taskValues(row),merged={...current};
 // A newer action on a card wins for the fields it changes. Keep unrelated typing.
 for(const key of Object.keys(current))if(edited[key]!==original[key]&&current[key]===original[key])merged[key]=edited[key];
 if(current.stage!==original.stage){for(const key of ['stage','focus','waiting_kind','waiting_since','followup_date'])merged[key]=current[key]}
 const next={...row,...taskValues(merged),initial:{...row,...current}};
 if(sameTaskValues(next,next.initial))taskEdits.delete(id);else taskEdits.set(id,next);
 updateTaskResume();
}
function updateTaskResume(){
 const button=$('task-resume');if(!button)return;
 button.hidden=!taskEdits.size;button.lastElementChild.textContent='編集の続き'+(taskEdits.size>1?' '+taskEdits.size:'');
}
function keepTaskEditor(){
 if(taskSaving)return;
 const d=readTaskEditor();if(!d)return;
 if(d.id){if(!sameTaskValues(d,d.initial))taskEdits.set(d.id,d);else taskEdits.delete(d.id)}
 else if(d.consumeDraft===false)taskEdits.set(d.editKey,d);
 else{syncNewTaskDraft();saveDraft()}
 $('task-dialog').close();updateTaskResume();
}
async function discardTaskEditor(){
 if(taskSaving)return;
 const d=S.dialog;if(!d)return;
 if(d.id)taskEdits.delete(d.id);
 else if(d.consumeDraft===false)taskEdits.delete(d.editKey);
 else if(activeTaskChanged()){
  S.draft={...S.draft,...taskValues(d.quickInitial||d.initial||{})};dirtyDraft();updateQuick();
  await saveDraft();
 }
 $('task-dialog').close();updateTaskResume();
 if(S.noteVersion===S.noteSaved&&S.draftSeq===S.draftSaved)status('saved');
}
function finishTaskEditor(d){taskEdits.delete(d.id||d.editKey);updateTaskResume()}
function taskEditsPending(){
 if(taskEdits.size)return true;
 if(!$('task-dialog').open)return false;
 const d=S.dialog;
 return !!d&&(d.id||d.consumeDraft===false)&&activeTaskChanged();
}
function protectTaskExit(event){
 if(S.restoring)return;
 syncNewTaskDraft();
 const big=new Blob([JSON.stringify(leavePayload())]).size>60000;
 if(taskEditsPending()||taskSaving||$('quick-add').disabled||S.saveError||(big&&(S.noteVersion!==S.noteSaved||S.draftSeq!==S.draftSaved))){event.preventDefault();event.returnValue=''}
}
function showTaskEditor(d,heading=null){
 S.dialog=d;$('dialog-heading').textContent=heading||(d.id?'タスクを編集':'新しいタスク');
 $('dialog-title').value=d.title||'';$('dialog-detail').value=d.detail||'';
 $('waiting-to').value=d.waiting_to||'';$('waiting-since').value=d.waiting_since||S.today;
 $('dialog-delete').hidden=!d.id;$('dialog-duplicate').hidden=!d.id;$('dialog-save').textContent=d.id?'保存':'追加';
 $('dialog-error').hidden=true;updateDialogMeta();
 if(!$('task-dialog').open)$('task-dialog').showModal();
 updateTaskEditStatus();$('dialog-title').focus();
}
$('task-form').addEventListener('input',updateTaskEditStatus);
$('task-form').addEventListener('change',updateTaskEditStatus);
$('dialog-close').onclick=keepTaskEditor;
$('dialog-cancel').onclick=discardTaskEditor;
$('task-dialog').addEventListener('cancel',event=>{event.preventDefault();keepTaskEditor()});
$('task-resume').onclick=()=>{
 const menu=$('task-resume-menu');if(!menu.hidden){menu.hidden=true;return}
 menu.innerHTML=[...taskEdits].map(([key,d])=>`<button role="menuitem" data-resume="${key}">${svg('quill')}<span>${esc(d.title.trim()||'無題のタスク')}</span></button>`).join('');
 positionMenu(menu,$('task-resume'));menu.querySelector('button')?.focus();
};
$('task-resume-menu').onclick=event=>{
 const button=event.target.closest('[data-resume]');if(!button)return;
 const key=/^\d+$/.test(button.dataset.resume)?Number(button.dataset.resume):button.dataset.resume,d=taskEdits.get(key);$('task-resume-menu').hidden=true;
 if(!d)return;if(typeof key==='string')showTaskEditor({...d},'タスクを複製');else openTask(key);
};
$('task-resume-menu').onkeydown=e=>{
 const menu=$('task-resume-menu');if(e.key==='Escape'){menu.hidden=true;$('task-resume').focus()}
 if(['ArrowDown','ArrowUp'].includes(e.key)){e.preventDefault();const list=[...menu.querySelectorAll('button')],i=list.indexOf(document.activeElement);list[(i+(e.key==='ArrowDown'?1:-1)+list.length)%list.length]?.focus()}
};
document.addEventListener('click',e=>{if(!e.target.closest('#task-resume,#task-resume-menu'))$('task-resume-menu').hidden=true});
window.addEventListener('beforeunload',protectTaskExit);

init();

