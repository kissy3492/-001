let holidayState=null,holidayTimer=null,holidayImporting=false,holidayMessage='';
function acceptHolidayState(data,redraw=true){
 if(!data||holidayState&&data.sequence<holidayState.sequence)return;
 const changed=data.revision!==holidayState?.revision;
 if(data.holidays&&changed)BusinessDays.configure(data.holidays);
 holidayState=data;renderHolidayStatus();
 if(changed&&redraw&&S.ready){updateQuick();if($('task-dialog').open)updateDialogMeta();if($('calendar-dialog').open)renderCalendar();if(S.page==='tasks')renderBoard()}
}
function renderHolidayStatus(){
 const data=holidayState;if(!data)return;
 $('holiday-range').textContent=`${data.last_year}年まで取得済み`;
 $('holiday-source').textContent=data.source==='builtin'?'内閣府の公表データを内蔵':`${data.source==='csv'?'CSV読込':'内閣府から取得'} ${fmtStamp(data.checked_at)}`;
 const busy=holidayImporting||data.busy;
 $('holiday-refresh').disabled=$('holiday-import').disabled=busy;
 $('holiday-refresh').textContent=data.busy?'更新中…':'今すぐ更新';
 $('holiday-status').textContent=holidayImporting?'読み込み中…':data.busy?'内閣府の祝日CSVを取得しています。':holidayMessage||data.error||'振替休日・国民の休日を含みます。';
 $('holiday-status').classList.toggle('has-error',!busy&&!!data.error&&!holidayMessage);
 clearTimeout(holidayTimer);
 if(data.busy&&$('holiday-dialog').open)holidayTimer=setTimeout(pollHoliday,800);
}
async function pollHoliday(){
 try{acceptHolidayState(await api('holiday.state',{revision:holidayState?.revision}))}
 catch(e){holidayMessage=e.message;renderHolidayStatus()}
}
$('holiday-btn').onclick=async()=>{$('menu').hidden=true;holidayMessage='';$('holiday-dialog').showModal();renderHolidayStatus();await pollHoliday()};
$('holiday-close').onclick=()=>$('holiday-dialog').close();
$('holiday-dialog').addEventListener('close',()=>clearTimeout(holidayTimer));
$('holiday-refresh').onclick=async()=>{
 if(holidayImporting||holidayState?.busy)return;
 holidayMessage='';$('holiday-refresh').disabled=$('holiday-import').disabled=true;
 try{acceptHolidayState(await api('holiday.refresh',{revision:holidayState?.revision}))}
 catch(e){holidayMessage=e.message;renderHolidayStatus()}
};
$('holiday-import').onclick=()=>{$('holiday-file').value='';$('holiday-file').click()};
$('holiday-file').onchange=async()=>{
 const file=$('holiday-file').files[0];if(!file)return;
 if(file.size>512*1024){holidayMessage='内閣府の祝日CSVを選んでください。';renderHolidayStatus();return}
 holidayImporting=true;holidayMessage='';renderHolidayStatus();
 try{
  const response=await fetch(base+'holiday-import',{method:'POST',headers:{'Content-Type':'text/csv'},body:file});
  const result=await response.json();if(!response.ok)throw Error(result.error||'CSVを読み込めませんでした。');
  holidayMessage='読み込みました。';acceptHolidayState(result)
 }catch(e){holidayMessage=e.message}
 finally{holidayImporting=false;renderHolidayStatus()}
};

let completionTimer=null,completionTarget=null;
const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');

function completedInRange(row){
 if(S.doneRange==='all')return true;
 const day=(row.completed||'').slice(0,10);
 if(S.doneRange==='today')return day===S.today;
 const monday=new Date(S.today+'T12:00:00');monday.setDate(monday.getDate()-(monday.getDay()+6)%7);
 return day>=dateISO(monday)&&day<=S.today
}
function completedDateText(value){
 if(!value)return '完了';
 const [date,time='']=value.split('T'),[y,m,d]=date.split('-').map(Number);
 const label=date===S.today?'今日':`${y===Number(S.today.slice(0,4))?'':y+'/'}${m}/${d}`;
 return label+' '+time.slice(0,5)+' 完了'
}
function completedCardHTML(row){
 return `<article class="card completed-card" draggable="true" data-id="${row.id}" tabindex="0" role="group" aria-label="${esc(row.title)}"><div class="completed-line">${svg('check')}<time datetime="${esc(row.completed)}" title="${esc(fmtStamp(row.completed))}">${esc(completedDateText(row.completed))}</time><button class="icon-button" data-act="edit" aria-label="編集" title="編集">${svg('more')}</button></div><h3>${esc(row.title)}</h3>${row.detail.trim()?`<p class="card-detail">${esc(row.detail)}</p>`:''}<div class="card-bottom"><button class="card-action" data-act="start" title="進行中に戻す">${svg('undo')}再開</button>${row.due_date?`<button class="due-tag" data-act="due" aria-label="期限を変更">${svg('calendar')}期限 ${esc(dueText(row))}</button>`:''}</div></article>`
}
function completionSource(id){
 if(!S.effects||reducedMotion.matches||S.page!=='tasks'||document.hidden)return null;
 const card=$('board').querySelector(`.card[data-id="${id}"]`);
 if(!card)return null;
 const r=card.getBoundingClientRect(),area=card.closest('.column-scroll').getBoundingClientRect();
 if(r.bottom<=area.top||r.top>=area.bottom)return null;
 const style=getComputedStyle(card);
 return {left:r.left,top:r.top,width:r.width,height:r.height,html:card.innerHTML,background:style.background,padding:style.padding,borderLeftWidth:style.borderLeftWidth,
  clipTop:Math.max(0,area.top-r.top),clipBottom:Math.max(0,r.bottom-area.bottom)}
}
function clearCompletionEffects(){
 clearTimeout(completionTimer);$('completion-effects').replaceChildren();
 completionTarget?.classList.remove('completion-arrived');completionTarget=null
}
function completedFeedback(row,undo,source){
 toast('完了しました',undo);$('toast').classList.add('completion-toast');
 $('toast-heading').textContent=row.title;$('toast-heading').hidden=false;
 $('toast-emblem').innerHTML=svg('check');$('toast-emblem').hidden=false;
 clearCompletionEffects();
 if(!S.effects||reducedMotion.matches||document.hidden||S.page!=='tasks')return;
 if(source){
  const echo=document.createElement('div');echo.className='completion-echo';echo.inert=true;
  Object.assign(echo.style,{left:source.left+'px',top:source.top+'px',width:source.width+'px',height:source.height+'px',background:source.background,padding:source.padding,borderLeftWidth:source.borderLeftWidth,clipPath:`inset(${source.clipTop}px 0 ${source.clipBottom}px 0 round 7px)`});
  echo.innerHTML=source.html;
  echo.querySelectorAll('[tabindex]').forEach(n=>n.removeAttribute('tabindex'));
  $('completion-effects').append(echo)
 }
 completionTarget=$('open-done')||$('board').querySelector(`.done .card[data-id="${row.id}"]`)||$('board').querySelector('.done .column-head');
 completionTarget?.classList.add('completion-arrived');
 completionTimer=setTimeout(clearCompletionEffects,560)
}
