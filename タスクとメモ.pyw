function highlightNote(text){
 const words=S.query.notes.trim().split(/\s+/).filter(Boolean);if(!words.length)return esc(text);
 const map=[];let normalized='';for(let i=0;i<text.length;){const char=String.fromCodePoint(text.codePointAt(i)),n=norm(char);for(let j=0;j<n.length;j++)map.push([i,i+char.length]);normalized+=n;i+=char.length}
 const spans=[];for(const word of words){const term=norm(word);let from=0;while(term&&from<normalized.length){const at=normalized.indexOf(term,from);if(at<0)break;spans.push([map[at][0],map[at+term.length-1][1]]);from=at+term.length}}
 spans.sort((a,b)=>a[0]-b[0]);let out='',pos=0;for(const [a,b] of spans){if(a<pos)continue;out+=esc(text.slice(pos,a))+'<mark>'+esc(text.slice(a,b))+'</mark>';pos=b}return out+esc(text.slice(pos))
}
