body[data-background]:not([data-background=library]) .waiting .card{background:linear-gradient(120deg,rgba(var(--scene-card),.98),rgba(var(--scene),.97))}
body[data-background]:not([data-background=library]) .card-detail{color:var(--scene-soft)}
