let locateTimer=null;
async function revealTask(id){
 const row=S.tasks.find(r=>r.id===id&&!r.deleted);if(!row)return;
 await showPage('tasks');if(S.page!=='tasks')return;
 S.filter='all';S.query.tasks='';S.searchExpanded=false;$('search').value='';
 if(row.stage==='完了'){S.doneOpen=true;S.doneRange='all'}
 const rows=row.stage==='完了'?matchingTasks().filter(r=>r.stage==='完了').sort((a,b)=>b.completed.localeCompare(a.completed)||b.id-a.id):filteredTasks().filter(r=>r.stage===row.stage);
 S.taskLimit[row.stage]=Math.max(S.taskLimit[row.stage],Math.ceil((rows.findIndex(r=>r.id===id)+1)/30)*30);
 renderBoard();const card=$('board').querySelector(`.card[data-id="${id}"]`);if(!card)return;
 card.scrollIntoView({block:'nearest',inline:'nearest',behavior:'instant'});card.focus({preventScroll:true});
 document.querySelectorAll('.located-card').forEach(n=>n.classList.remove('located-card'));clearTimeout(locateTimer);
 card.classList.add('located-card');locateTimer=setTimeout(()=>card.classList.remove('located-card'),1000)
}
