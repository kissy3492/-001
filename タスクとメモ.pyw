APP_NAME = "タスクとメモ"
DB_NAME = "タスクとメモ.sqlite3"
STAGES = ("作業前", "作業中", "相手待ち", "完了")
WAITING_KINDS = ("依頼中", "回答待ち", "決裁中", "確認待ち")
BACKGROUNDS = ("library", "hearth", "forest", "clouds", "snowtown")

def valid_background(value):
    return value if isinstance(value, str) and value in BACKGROUNDS else 'library'

def stamp():
    return dt.datetime.now().isoformat(timespec="microseconds")


def today():
    return dt.date.today().isoformat()


def normalize(value):
    return unicodedata.normalize("NFKC", str(value)).casefold()


def search_text(*values):
    return normalize("\n".join(str(v or "") for v in values))


def parse_date(value):
    value = normalize(value).strip()
    if not value:
        return ""
    value = value.replace("年", "-").replace("月", "-").replace("日", "")
    value = value.replace("/", "-").replace(".", "-")
    if re.fullmatch(r"\d{8}", value):
        value = f"{value[:4]}-{value[4:6]}-{value[6:]}"
    bits = value.split("-")
    if len(bits) == 2:
        bits.insert(0, str(dt.date.today().year))
    try:
        if len(bits) != 3:
            raise ValueError
        return dt.date(*(int(p) for p in bits)).isoformat()
    except (ValueError, TypeError):
        raise ValueError("日付は 2026/9/24 または 9/24 のように入力してください。") from None


def parse_time(value):
    value = normalize(value).strip()
    if not value:
        return ""
    if re.fullmatch(r"\d{3,4}", value):
        value = value.zfill(4)
        value = value[:2] + ":" + value[2:]
    try:
        if not re.fullmatch(r"\d{1,2}:\d{2}", value):
            raise ValueError
        h, m = map(int, value.split(":"))
        return dt.time(h, m).strftime("%H:%M")
    except ValueError:
        raise ValueError("時刻は 9:00 または 0900 のように入力してください。") from None


def deadline_kind(row, now=None):
    if row["stage"] == "完了" or not row["due_date"]:
        return "normal"
    now = now or dt.datetime.now()
    due = row["due_date"]
    if due < now.date().isoformat():
        return "overdue"
    if due == now.date().isoformat():
        if row["due_time"] and row["due_time"] < now.strftime("%H:%M"):
            return "overdue"
        return "today"
    return "normal"


class SingleInstance:
    """OS releases this lock on exit, including abnormal exits."""
    def __init__(self, path):
        self.file = open(path, "a+b")
        self.file.seek(0, os.SEEK_END)
        if self.file.tell() == 0:
            self.file.write(b"0")
            self.file.flush()
        self.file.seek(0)
        try:
            if os.name == "nt":
                import msvcrt
                msvcrt.locking(self.file.fileno(), msvcrt.LK_NBLCK, 1)
            else:
                import fcntl
                fcntl.flock(self.file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.file.close()
            raise RuntimeError("このフォルダのツールは既に開いています。\n開いている画面をご利用ください。") from None

    def close(self):
        self.file.close()


class Store:
    def __init__(self, path):
        self.path = Path(path)
        self.conn = sqlite3.connect(str(path), timeout=3, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("PRAGMA synchronous=FULL")
        self.conn.executescript("""
            CREATE TABLE IF NOT EXISTS tasks (
                id INTEGER PRIMARY KEY, title TEXT NOT NULL, detail TEXT NOT NULL DEFAULT '',
                due_date TEXT NOT NULL DEFAULT '', due_time TEXT NOT NULL DEFAULT '',
                stage TEXT NOT NULL DEFAULT '作業前', focus_date TEXT NOT NULL DEFAULT '',
                created TEXT NOT NULL, updated TEXT NOT NULL, completed TEXT NOT NULL DEFAULT '',
                deleted TEXT NOT NULL DEFAULT '', search TEXT NOT NULL);
            CREATE INDEX IF NOT EXISTS task_order ON tasks(deleted,stage,due_date);
            CREATE TABLE IF NOT EXISTS notes (
                id INTEGER PRIMARY KEY, title TEXT NOT NULL DEFAULT '', body TEXT NOT NULL DEFAULT '',
                created TEXT NOT NULL, updated TEXT NOT NULL, deleted TEXT NOT NULL DEFAULT '',
                search TEXT NOT NULL);
            CREATE INDEX IF NOT EXISTS note_order ON notes(deleted,updated DESC);
        """)
        # Add the handoff fields in place so existing tasks keep their IDs and dates.
        columns = {r[1] for r in self.conn.execute("PRAGMA table_info(tasks)")}
        with self.conn:
            for name, default in (("waiting_kind", "依頼中"), ("waiting_to", ""), ("waiting_since", ""), ("followup_date", "")):
                if name not in columns:
                    self.conn.execute(f"ALTER TABLE tasks ADD COLUMN {name} TEXT NOT NULL DEFAULT '{default}'")
            if 'pinned' not in {r[1] for r in self.conn.execute('PRAGMA table_info(notes)')}:
                self.conn.execute('ALTER TABLE notes ADD COLUMN pinned INTEGER NOT NULL DEFAULT 0')

    def task(self, ident):
        row = self.conn.execute("SELECT * FROM tasks WHERE id=?", (ident,)).fetchone()
        return dict(row) if row else None

    def add_task(self, title, detail="", due_date="", due_time="", stage="作業前", focus=False,
                 waiting_kind="依頼中", waiting_to="", waiting_since="", followup_date=""):
        title = title.strip()
        if not title:
            raise ValueError("仕事内容を入力してください。")
        if stage not in STAGES:
            raise ValueError("段階を選んでください。")
        if waiting_kind not in WAITING_KINDS:
            raise ValueError("相手待ちの状態を選んでください。")
        waiting_to = waiting_to.strip()
        waiting_since = (parse_date(waiting_since) or today()) if stage == "相手待ち" else ""
        followup_date = parse_date(followup_date) if stage == "相手待ち" else ""
        due_date, due_time = parse_date(due_date), parse_time(due_time)
        if due_time and not due_date:
            raise ValueError("時刻を指定するときは日付も選んでください。")
        now = stamp()
        with self.conn:
            cur = self.conn.execute("""INSERT INTO tasks
                (title,detail,due_date,due_time,stage,focus_date,created,updated,completed,search,
                 waiting_kind,waiting_to,waiting_since,followup_date)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""", (title,detail,due_date,due_time,stage,
                today() if focus and stage != "完了" else "",now,now,now if stage == "完了" else "",
                search_text(title,detail,waiting_to,waiting_kind if stage == "相手待ち" else ""),
                waiting_kind,waiting_to,waiting_since,followup_date))
        return cur.lastrowid

    def update_task(self, ident, **changes):
        row = self.task(ident)
        if row is None:
            raise ValueError("タスクが見つかりません。")
        old_stage = row["stage"]
        allowed = {"title", "detail", "due_date", "due_time", "stage", "focus_date", "deleted", "completed",
                   "waiting_kind", "waiting_to", "waiting_since", "followup_date"}
        row.update({k:v for k,v in changes.items() if k in allowed})
        row["title"] = row["title"].strip()
        if not row["title"]:
            raise ValueError("仕事内容を入力してください。")
        if row["stage"] not in STAGES:
            raise ValueError("段階を選んでください。")
        if row["waiting_kind"] not in WAITING_KINDS:
            raise ValueError("相手待ちの状態を選んでください。")
        row["waiting_to"] = row["waiting_to"].strip()
        if row["stage"] == "相手待ち":
            row["waiting_since"] = parse_date(row["waiting_since"]) or today()
            row["followup_date"] = parse_date(row["followup_date"])
        else:
            row["waiting_since"] = ""
            row["followup_date"] = ""
        if row["stage"] == "完了" or (old_stage == "完了" and "focus_date" not in changes):
            row["focus_date"] = ""
        row["due_date"], row["due_time"] = parse_date(row["due_date"]), parse_time(row["due_time"])
        if row["due_time"] and not row["due_date"]:
            raise ValueError("時刻を指定するときは日付も選んでください。")
        row["updated"] = stamp()
        if row["stage"] != old_stage and "completed" not in changes:
            row["completed"] = stamp() if row["stage"] == "完了" else ""
        row["search"] = search_text(row["title"], row["detail"], row["waiting_to"],
                                    row["waiting_kind"] if row["stage"] == "相手待ち" else "")
        with self.conn:
            self.conn.execute("""UPDATE tasks SET title=:title,detail=:detail,due_date=:due_date,
                due_time=:due_time,stage=:stage,focus_date=:focus_date,updated=:updated,
                completed=:completed,deleted=:deleted,search=:search,
                waiting_kind=:waiting_kind,waiting_to=:waiting_to,waiting_since=:waiting_since,followup_date=:followup_date
                WHERE id=:id""", row)

    def tasks(self, query="", mode="すべて"):
        sql, args = "SELECT * FROM tasks WHERE deleted=''", []
        for term in normalize(query).split():
            sql += " AND instr(search,?)>0"
            args.append(term)
        if mode in ("フォーカス", "今日やる"):
            sql += " AND focus_date!='' AND stage!='完了'"
        elif mode == "今日が期限":
            sql += " AND due_date=? AND stage!='完了'"
            args.append(today())
        elif mode == "相手待ち":
            sql += " AND stage='相手待ち'"
        elif mode == "フォロー":
            sql += " AND stage='相手待ち' AND followup_date!='' AND followup_date<=?"
            args.append(today())
        rows = [dict(r) for r in self.conn.execute(sql, args)]
        if mode == "期限超過":
            rows = [r for r in rows if deadline_kind(r) == "overdue"]
        return sorted(rows, key=lambda r: (r["due_date"] or "9999-12-31", r["due_time"] or "23:59", r["created"]))

    def add_note(self):
        now = stamp()
        with self.conn:
            cur = self.conn.execute("INSERT INTO notes(title,body,created,updated,search) VALUES ('','',?,?,?)",
                                    (now, now, search_text(now[:10])))
        return cur.lastrowid

    def note(self, ident):
        row = self.conn.execute("SELECT * FROM notes WHERE id=?", (ident,)).fetchone()
        return dict(row) if row else None

    def save_note(self, ident, title, body):
        old = self.note(ident)
        if old is None:
            raise ValueError("メモが見つかりません。")
        if old["title"] == title and old["body"] == body:
            return old
        with self.conn:
            self.conn.execute("UPDATE notes SET title=?,body=?,updated=?,search=? WHERE id=?",
                              (title,body,stamp(),search_text(title,body,old["created"][:10]),ident))
        return self.note(ident)

    def notes(self, query="", date_query=""):
        sql, args = "SELECT * FROM notes WHERE deleted=''", []
        for term in normalize(query).split():
            sql += " AND instr(search,?)>0"
            args.append(term)
        date_query = normalize(date_query).strip().replace("/", "-").replace("年", "-").replace("月", "-").replace("日", "")
        if date_query:
            bits = date_query.strip("-").split("-")
            if bits and all(p.isdigit() for p in bits):
                date_query = "-".join([bits[0]] + [p.zfill(2) for p in bits[1:]])
            sql += " AND instr(substr(created,1,10),?)>0"
            args.append(date_query)
        sql += " ORDER BY pinned DESC,updated DESC,id DESC"
        return [dict(r) for r in self.conn.execute(sql,args)]

    def pin_note(self, ident, pinned):
        row = self.note(ident)
        if row is None or row['deleted']:
            raise ValueError('メモが見つかりません。')
        with self.conn:
            self.conn.execute('UPDATE notes SET pinned=? WHERE id=?', (int(bool(pinned)), ident))
        return self.note(ident)

    def delete(self, table, ident, deleted=True):
        if table not in ("tasks", "notes"):
            raise ValueError("保存先が不正です。")
        with self.conn:
            self.conn.execute(f"UPDATE {table} SET deleted=? WHERE id=?", (stamp() if deleted else "",ident))

    def deleted_items(self, query="", limit=60):
        terms = normalize(query).split()
        where = "deleted!=''" + " AND instr(search,?)>0" * len(terms)
        sql = f"""SELECT 'tasks' AS kind,id,title,substr(detail,1,180) AS preview,deleted
                  FROM tasks WHERE {where}
                  UNION ALL
                  SELECT 'notes' AS kind,id,
                    CASE WHEN trim(title)='' THEN substr(body,1,100) ELSE title END,
                    substr(body,1,180),deleted FROM notes WHERE {where}
                  ORDER BY deleted DESC,kind,id DESC LIMIT ?"""
        rows = [dict(r) for r in self.conn.execute(sql, terms + terms + [limit + 1])]
        return {"items": rows[:limit], "more": len(rows) > limit}

    @staticmethod
    def read_backup(path):
        """Read a user-selected backup; never run its triggers or replace the live database file."""
        conn = sqlite3.connect(Path(path).resolve().as_uri() + '?mode=ro', uri=True)
        conn.row_factory = sqlite3.Row
        try:
            conn.execute('PRAGMA query_only=ON')
            conn.execute('PRAGMA trusted_schema=OFF')
            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if not {'tasks', 'notes'} <= tables:
                raise ValueError('このツールのバックアップを選んでください。')
            result = {}
            fields = {
                'tasks': ('id','title','detail','due_date','due_time','stage','focus_date','created',
                          'updated','completed','deleted','waiting_kind','waiting_to','waiting_since','followup_date'),
                'notes': ('id','title','body','created','updated','deleted','pinned')}
            for table, names in fields.items():
                columns = {r[1] for r in conn.execute(f'PRAGMA table_info({table})')}
                required = {'id','title','created','updated', 'stage' if table == 'tasks' else 'body'}
                if not required <= columns:
                    raise ValueError('このツールのバックアップを選んでください。')
                selected = ','.join(name for name in names if name in columns)
                rows = []
                for record in conn.execute(f'SELECT {selected} FROM {table}'):
                    values = dict(record)
                    row = {name: values.get(name, '依頼中' if name == 'waiting_kind' else 0 if name == 'pinned' else '') for name in names}
                    if not isinstance(row['id'], int) or row['id'] <= 0 or any(not isinstance(v,str) for k,v in row.items() if k not in ('id','pinned')):
                        raise ValueError('バックアップを読み込めません。別の控えを選んでください。')
                    if table == 'notes' and (not isinstance(row['pinned'],int) or row['pinned'] not in (0,1)):
                        raise ValueError('メモのしおりを読み込めません。')
                    if table == 'tasks':
                        if row['stage'] not in STAGES or row['waiting_kind'] not in WAITING_KINDS:
                            raise ValueError('対応していないタスクの状態が含まれています。')
                        row['search'] = search_text(row['title'],row['detail'],row['waiting_to'],
                                                  row['waiting_kind'] if row['stage']=='相手待ち' else '')
                    else:
                        row['search'] = search_text(row['title'],row['body'],row['created'][:10])
                    rows.append(row)
                result[table] = rows
            preferences = {}
            if 'preferences' in tables:
                for key,value in conn.execute("SELECT key,value FROM preferences WHERE key IN ('draft','effects','background')"):
                    parsed = json.loads(value)
                    if key == 'effects' and isinstance(parsed,bool):
                        preferences[key] = parsed
                    elif key == 'background':
                        preferences[key] = valid_background(parsed)
                    elif key == 'draft' and isinstance(parsed,dict):
                        draft = {k:str(parsed.get(k,'') or '') for k in
                                 ('title','detail','due_date','due_time','stage','waiting_kind','waiting_to','waiting_since','followup_date')}
                        draft['focus'] = bool(parsed.get('focus'))
                        if draft['stage'] not in STAGES: draft['stage'] = '作業前'
                        if draft['waiting_kind'] not in WAITING_KINDS: draft['waiting_kind'] = '依頼中'
                        preferences[key] = draft
            result['preferences'] = preferences
            return result
        finally:
            conn.close()

    def restore_contents(self, snapshot):
        # A single transaction keeps the current data intact on any write failure.
        with self.conn:
            for table in ('tasks','notes'):
                self.conn.execute(f'DELETE FROM {table}')
                rows = snapshot[table]
                if rows:
                    names = tuple(rows[0])
                    sql = f"INSERT INTO {table} ({','.join(names)}) VALUES ({','.join('?' for _ in names)})"
                    self.conn.executemany(sql, ([r[name] for name in names] for r in rows))
            self.conn.execute('DELETE FROM preferences')
            self.conn.executemany('INSERT INTO preferences(key,value) VALUES (?,?)',
                                 [(key,json.dumps(value,ensure_ascii=False)) for key,value in snapshot['preferences'].items()])

    def backup(self, destination):
        destination = Path(destination)
        if destination.resolve() == self.path.resolve():
            raise ValueError("使用中のデータとは別のファイル名を指定してください。")
        # Commit the backup through a temporary file; an interrupted copy cannot replace the destination.
        temp = destination.with_name(destination.name + ".tmp")
        target = None
        try:
            target = sqlite3.connect(str(temp))
            with target:
                self.conn.backup(target)
            target.close()
            target = None
            os.replace(temp, destination)
        finally:
            if target is not None:
                target.close()
            if temp.exists():
                temp.unlink()

    def close(self):
        self.conn.close()


