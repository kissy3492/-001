.background-dialog{position:fixed;inset:auto auto 24px 125px;margin:0;width:650px;padding:22px;border-color:#c9a87566;overflow:auto;max-height:calc(100vh - 48px)}
.background-dialog::backdrop{background:#08040e26;backdrop-filter:none}
.background-dialog .dialog-head{margin-bottom:18px}
.background-dialog .dialog-head h2{font-size:20px}
.background-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.background-choice{display:block;text-align:left;min-width:0;padding:0;border:1px solid #b99c5e38;border-radius:7px;background:#15101ddb;color:#d4c4cb;overflow:hidden;transition:border-color .16s,background .16s,box-shadow .16s}
.background-choice:hover{border-color:#d7b97999;background:#302239;box-shadow:0 0 0 1px #d7b97912}
.background-choice:active:not(:disabled){transform:none}
.background-choice[aria-pressed=true]{border-color:#d2b077;background:#3b2c3b;box-shadow:0 0 0 1px #cba97124}
.background-choice.pending{border-color:#b99ccc}
.background-picture{position:relative;display:block;aspect-ratio:16/9;background:#17121f;overflow:hidden}
.background-picture img{display:block;width:100%;height:100%;object-fit:cover}
.background-check{position:absolute;right:9px;bottom:9px;width:22px;height:22px;background:#dcc18b;color:#322337;border:1px solid #f5dfaf;box-shadow:0 2px 8px #0008;border-radius:50%;display:grid;place-items:center}
.background-check svg{width:14px;height:14px;stroke-width:2}
.background-caption{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:11px 12px;font-size:12px;line-height:1.5;white-space:nowrap}
.background-state{font-size:10px;color:#d9bd87}
.background-number{position:absolute;top:8px;left:8px;background:#0b0d13c9;border:1px solid #d7c69c55;border-radius:4px;color:#f1dec0;padding:3px 6px;font-size:10px;line-height:1.2;font-variant-numeric:tabular-nums}
.background-dialog .error-text{margin-bottom:0}
@media(max-width:700px){.background-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.background-dialog{inset:auto auto 18px 18px;width:min(464px,calc(100vw - 36px))}}

