class HolidayCalendar:
    """Official CSV only; a background download never holds the task database lock."""
    MAX_BYTES = 512 * 1024

    def __init__(self, folder):
        self.path = Path(folder) / '祝日データ.json'
        self.lock = threading.RLock()
        self.busy = False
        self.sequence = 0
        self.worker = None
        self.data = dict(holidays=HOLIDAY_SEED, source='builtin', checked_at='',
                         attempted_on='', error='')
        try:
            saved = json.loads(self.path.read_text(encoding='utf-8'))
            self.validate(saved['holidays'])
            if min(saved['holidays']) <= min(HOLIDAY_SEED) and max(saved['holidays']) >= max(HOLIDAY_SEED):
                self.data = dict(holidays=saved['holidays'], source=saved.get('source','csv'),
                                 checked_at=str(saved.get('checked_at','')),
                                 attempted_on=str(saved.get('attempted_on','')),
                                 error=str(saved.get('error','')))
        except (OSError, ValueError, KeyError, TypeError):
            pass
        self._revision()

    @staticmethod
    def validate(days):
        if not isinstance(days, dict) or not days:
            raise ValueError('内閣府の祝日CSVを選んでください。')
        years = {}
        for date, name in days.items():
            if not isinstance(date,str) or not isinstance(name,str) or not name.strip() or len(name)>200:
                raise ValueError('祝日CSVを読み込めません。')
            d = dt.date.fromisoformat(date)
            if d.isoformat() != date or d.year < 1955:
                raise ValueError('祝日CSVの日付を読み込めません。')
            years.setdefault(d.year, set()).add(date[5:])
        # Reject a truncated file instead of treating missing holidays as working days.
        for year in range(min(years), max(years)+1):
            dates = years.get(year, set())
            if len(dates) < 9 or not {'01-01','11-23'} <= dates:
                raise ValueError('祝日CSVが途中までしかありません。内閣府から再取得してください。')

    @classmethod
    def parse_csv(cls, content):
        if not content or len(content) > cls.MAX_BYTES:
            raise ValueError('内閣府の祝日CSVを選んでください。')
        try:
            text = content.decode('utf-8-sig')
        except UnicodeDecodeError:
            try:
                text = content.decode('cp932')
            except UnicodeDecodeError as exc:
                raise ValueError('祝日CSVの文字を読み込めません。') from exc
        rows = csv.reader(io.StringIO(text))
        header = next(rows, [])
        if [s.strip() for s in header] != ['国民の祝日・休日月日','国民の祝日・休日名称']:
            raise ValueError('内閣府の「国民の祝日」CSVを選んでください。')
        days = {}
        for row in rows:
            if not row or all(not s.strip() for s in row):
                continue
            if len(row) != 2 or not re.fullmatch(r'\d{4}/\d{1,2}/\d{1,2}', row[0].strip()):
                raise ValueError('祝日CSVの日付を読み込めません。')
            try:
                date = dt.date(*map(int, row[0].strip().split('/'))).isoformat()
            except ValueError as exc:
                raise ValueError('祝日CSVの日付を読み込めません。') from exc
            name = row[1].strip()
            if date in days and days[date] != name:
                raise ValueError('同じ日付の祝日が重複しています。CSVを再取得してください。')
            days[date] = name
        cls.validate(days)
        return dict(sorted(days.items()))

    def _revision(self):
        self.revision = hashlib.sha256(json.dumps(self.data['holidays'], sort_keys=True,
                                      ensure_ascii=False).encode('utf-8')).hexdigest()[:20]

    def state(self, known_revision=None):
        with self.lock:
            days = self.data['holidays']
            result = dict(revision=self.revision, sequence=self.sequence, busy=self.busy,
                          first_year=int(min(days)[:4]), last_year=int(max(days)[:4]),
                          source=self.data['source'], checked_at=self.data['checked_at'],
                          error=self.data['error'])
            if known_revision != self.revision:
                result['holidays'] = days.copy()
            return result

    def _write(self, data):
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=self.path.parent,
                                             prefix='.holiday-', suffix='.tmp', delete=False) as stream:
                temporary = Path(stream.name)
                json.dump(data, stream, ensure_ascii=False, separators=(',',':'))
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, self.path)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)

    def _install(self, days, source):
        with self.lock:
            current = self.data['holidays']
            if min(days) > min(current) or max(days) < max(current):
                raise ValueError('現在より古い、または一部だけのCSVです。今の祝日データを使い続けます。')
            updated = dict(holidays=days, source=source, checked_at=stamp(),
                           attempted_on=today(), error='')
            self._write(updated)
            self.data = updated
            self._revision()

    @classmethod
    def download(cls):
        # Only this public URL is requested. No task/memo content is sent.
        request = urllib.request.Request(HOLIDAY_URL, headers={'Accept':'text/csv,*/*;q=0.5',
                                          'User-Agent':'TaskMemo Holiday Calendar'})
        with urllib.request.urlopen(request, timeout=20) as response:
            target = urlsplit(response.geturl())
            if target.scheme != 'https' or target.hostname != 'www8.cao.go.jp':
                raise ValueError('内閣府の祝日CSVを取得できませんでした。')
            content = response.read(cls.MAX_BYTES+1)
        return cls.parse_csv(content)

    def refresh(self, force=False):
        with self.lock:
            if self.busy or (not force and self.data['attempted_on'] == today()):
                return
            self.busy = True
            self.data = dict(self.data, attempted_on=today(), error='')
            self.sequence += 1
            self.worker = threading.Thread(target=self._fetch, daemon=True)
            self.worker.start()

    def _fetch(self):
        try:
            days = self.download()
            self._install(days, 'online')
        except Exception as exc:
            with self.lock:
                message = str(exc) if isinstance(exc, ValueError) else '取得できませんでした。保存済みの祝日データを使っています。'
                self.data = dict(self.data, error=message)
                try:
                    self._write(self.data)
                except OSError:
                    pass
        finally:
            with self.lock:
                self.busy = False
                self.sequence += 1

    def import_csv(self, content):
        with self.lock:
            if self.busy:
                raise ValueError('更新中です。少し待ってから読み込んでください。')
            try:
                days = self.parse_csv(content)
            except csv.Error as exc:
                raise ValueError('内閣府の祝日CSVを選んでください。') from exc
            self._install(days, 'csv')
            self.sequence += 1
            return self.state()


