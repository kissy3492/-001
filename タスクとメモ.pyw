.card.dragging{opacity:.5;transform:none}.card-action[data-act=complete]:hover{color:#f0d29a;border-color:#d7b67777;background:#b4934c22}.card-action[data-act=wait]:hover{color:#e9c3d1;border-color:#bc8fa677;background:#a7738e20}
