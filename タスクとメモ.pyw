const taskIndex=new WeakMap(),noteIndex=new WeakMap();
function indexedTask(row){let cached=taskIndex.get(row);if(!cached){cached=norm(row.title+'\n'+row.detail+'\n'+(row.waiting_to||'')+'\n'+(row.stage==='相手待ち'?row.waiting_kind:''));taskIndex.set(row,cached)}return cached}
function indexedNote(row){let cached=noteIndex.get(row);if(!cached||cached.title!==row.title||cached.body!==row.body){cached={title:row.title,body:row.body,text:norm(row.title+'\n'+row.body)};noteIndex.set(row,cached)}return cached.text}
function setText(node,text){text=String(text);if(node.textContent!==text)node.textContent=text}
function setHTML(node,html){if(node._html!==html){node.innerHTML=html;node._html=html}}
function patchChildren(parent,items){const existing=new Map([...parent.children].map(n=>[n._key,n]));for(let i=0;i<items.length;i++){const item=items[i];let node=existing.get(item.key);existing.delete(item.key);if(!node||node._html!==item.html){const template=document.createElement('template');template.innerHTML=item.html;const replacement=template.content.firstElementChild;replacement._key=item.key;replacement._html=item.html;if(node)node.replaceWith(replacement);node=replacement}if(parent.children[i]!==node)parent.insertBefore(node,parent.children[i]||null)}for(const node of existing.values())node.remove()}

// Counts only the years included in the loaded Cabinet Office CSV.
const BusinessDays=(()=>{
 let official={},firstYear=0,lastYear=0;
 const DAY=86400000,years=new Map();
 const iso=d=>d.toISOString().slice(0,10);
 function parse(s){if(!/^\d{4}-\d{2}-\d{2}$/.test(s))return null;const d=new Date(s+'T00:00:00Z');return Number.isFinite(+d)&&iso(d)===s?d:null}
 function configure(days){official=days;const dates=Object.keys(days).sort();firstYear=Number(dates[0]?.slice(0,4)||0);lastYear=Number(dates.at(-1)?.slice(0,4)||0);years.clear()}
 function yearData(year){
  if(year<firstYear||year>lastYear)return null;
  if(years.has(year))return years.get(year);
  const holidays=new Map(Object.entries(official).filter(([date])=>date.startsWith(year+'-')));
  const first=Date.UTC(year,0,1),length=(Date.UTC(year+1,0,1)-first)/DAY,prefix=new Uint16Array(length+1);
  for(let i=0;i<length;i++){const d=new Date(first+i*DAY);prefix[i+1]=prefix[i]+Number(d.getUTCDay()!==0&&d.getUTCDay()!==6&&!holidays.has(iso(d)))}
  const result={holidays,first,prefix};years.set(year,result);return result;
 }
 function between(start,end){
  const a=parse(start),b=parse(end);if(!a||!b)return null;
  if(a>b){const r=between(end,start);return r?{...r,days:-r.days}:null}
  if(a.getUTCFullYear()<firstYear||b.getUTCFullYear()>lastYear)return null;
  let count=0;
  for(let y=a.getUTCFullYear();y<=b.getUTCFullYear();y++){
   const {first,prefix}=yearData(y),lo=y===a.getUTCFullYear()?Math.round((a-first)/DAY)+1:0,hi=y===b.getUTCFullYear()?Math.round((b-first)/DAY)+1:prefix.length-1;
   count+=prefix[hi]-prefix[lo];
  }
  return {days:count};
 }
 function dayInfo(s){const d=parse(s);if(!d)return null;const data=yearData(d.getUTCFullYear()),holiday=data?.holidays.get(s)||'';return {holiday,off:!!holiday||[0,6].includes(d.getUTCDay()),supported:!!data}}
 function advance(start,count){
  const d=parse(start);if(!d||!Number.isInteger(count)||count<1||count>365)return null;
  while(count){d.setUTCDate(d.getUTCDate()+1);const s=iso(d),info=dayInfo(s);if(!info?.supported)return null;if(!info.off)count--;if(!count)return s}
  return null;
 }
 return {between,dayInfo,advance,configure,lastYear:()=>lastYear};
})();

function businessInfo(row){
 if(!row.due_date||row.stage==='完了')return null;
 const result=BusinessDays.between(S.today,row.due_date);if(!result)return {label:'祝日未取得',tip:`祝日データは${BusinessDays.lastYear()}年まで取得済みです。メニューの「祝日データ」から更新できます。未公表の年は稼働日数を計算しません。`,late:false};
 const late=row.due_date<S.today,day=BusinessDays.dayInfo(row.due_date);
 const label=row.due_date===S.today?'今日が期限':late?(result.days?`${Math.abs(result.days)}稼働日超過`:'期限超過'):`あと${result.days}稼働日`;
 const tip=(late?'期限日の翌日から今日まで':'今日を含めず、期限日まで')+'の土日・祝日・振替休日・国民の休日を除いた日数。'+(day.off?' 期限日は休日です。登録した期限日は変更しません。':'');
 return {label,tip,late};
}
function businessBadge(row){
 const info=businessInfo(row);if(!info||row.due_date===S.today||row.due_date<S.today&&BusinessDays.between(S.today,row.due_date)?.days===0)return '';
 return `<span class="business-days${info.late?' is-late':''}" title="${esc(info.tip)}">${esc(info.label)}</span>`;
}
function updateBusinessLabel(id,row){
 const node=$(id),info=businessInfo(row);node.hidden=!info;node.textContent=info?.label||'';node.title=info?.tip||'';node.classList.toggle('is-late',!!info?.late);
}
