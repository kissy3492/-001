 const due=followupDue(row),label=row.followup_date===S.today?'今日の確認':(due?'確認 ':'次の確認 ')+shortFollowupDate(row.followup_date);
 return `<div class="followup-line${due?' followup-due':''}"><button class="followup-date" data-act="followup" title="確認日を変更">${svg('calendar')}<span>${esc(label)}</span></button>${due?`<button class="icon-button followup-done" data-act="followup-done" title="確認済みにする" aria-label="確認済みにする">${svg('check')}</button>`:''}</div>`;
}
