}

let deletedTimer=null,deletedSequence=0,deletedLimit=60,deletedLast=null;
const deletedBusy=new Set();
async function loadDeleted(){
 const seq=++deletedSequence;$('deleted-clear').hidden=!$('deleted-search').value;
 try{
  const data=await api('deleted.list',{query:$('deleted-search').value,limit:deletedLimit});if(seq!==deletedSequence)return;
  $('deleted-error').hidden=true;
  $('deleted-list').innerHTML=data.items.length?data.items.map(row=>`<div class="deleted-row"><span class="deleted-kind">${svg(row.kind==='tasks'?'board':'note')}</span><div class="deleted-copy"><h3>${esc(row.title.trim()||'無題のメモ')}</h3>${row.preview.trim()?`<p>${esc(row.preview.replace(/\s+/g,' '))}</p>`:''}<time>${row.kind==='tasks'?'タスク':'メモ'} · 削除 ${esc(fmtStamp(row.deleted))}</time></div><button class="quiet deleted-restore" data-kind="${row.kind}" data-id="${row.id}" ${deletedBusy.has(row.kind+row.id)?'disabled':''}>戻す</button></div>`).join('')+(data.more?'<button class="more" id="deleted-more">さらに表示</button>':''):`<div class="recovery-empty">${svg('inbox')}<span>${$('deleted-search').value?'該当なし':'削除した項目はありません'}</span></div>`
 }catch(error){if(seq!==deletedSequence)return;$('deleted-error').textContent=error.message;$('deleted-error').hidden=false}
}
$('deleted-btn').onclick=async()=>{
 $('menu').hidden=true;if(!await settledEdits())return;
 $('deleted-search').value='';deletedLimit=60;deletedLast=null;$('deleted-feedback').hidden=true;$('deleted-error').hidden=true;
 $('deleted-list').innerHTML='<div class="recovery-empty">読み込み中…</div>';$('deleted-dialog').showModal();$('deleted-search').focus();await loadDeleted()
};
$('deleted-close').onclick=()=>$('deleted-dialog').close();
$('deleted-search').oninput=()=>{clearTimeout(deletedTimer);deletedLimit=60;deletedTimer=setTimeout(loadDeleted,130)};
$('deleted-clear').onclick=()=>{$('deleted-search').value='';deletedLimit=60;clearTimeout(deletedTimer);loadDeleted();$('deleted-search').focus()};
$('deleted-list').onclick=async event=>{
 if(event.target.closest('#deleted-more')){deletedLimit+=60;await loadDeleted();return}
 const button=event.target.closest('.deleted-restore');if(!button)return;
 const kind=button.dataset.kind,id=Number(button.dataset.id),key=kind+id;if(deletedBusy.has(key))return;
 deletedBusy.add(key);button.disabled=true;
 try{
  const res=await api('deleted.restore',{kind,id});replaceRow(kind,res.row);deletedLast={kind,id};
  if(S.page==='tasks')renderBoard();else renderNotes();
  $('deleted-feedback-text').textContent=(res.row.title.trim()||res.row.body?.trim().split(/\r?\n/)[0]||'無題のメモ')+' を戻しました';$('deleted-feedback').hidden=false;
  await loadDeleted();status('saved')
 }catch(error){$('deleted-error').textContent=error.message;$('deleted-error').hidden=false}
 finally{deletedBusy.delete(key);button.disabled=false}
};
$('deleted-show').onclick=async()=>{
