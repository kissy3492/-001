 if(kind==='tasks')await revealTask(id);else await revealNote(id)
};

let restoreTicket=null,restoreReading=false,restoreBusy=false,restoreController=null,restoreSequence=0;
function restoreError(error){$('restore-error').textContent=error.message||String(error);$('restore-error').hidden=false}
function setRestoreBusy(busy){restoreBusy=busy;['restore-pick','restore-close','restore-cancel','restore-confirm'].forEach(id=>$(id).disabled=busy);if(!busy)$('restore-confirm').disabled=!restoreTicket}
function closeRestore(){if(!restoreBusy)$('restore-dialog').close()}
$('restore-btn').onclick=async()=>{
 $('menu').hidden=true;if(!await settledEdits())return;
 restoreTicket=null;restoreReading=false;$('restore-file').value='';$('restore-file-name').textContent='バックアップを選ぶ';
 $('restore-preview').hidden=true;$('restore-error').hidden=true;setRestoreBusy(false);$('restore-dialog').showModal()
};
$('restore-pick').onclick=()=>$('restore-file').click();
$('restore-close').onclick=$('restore-cancel').onclick=closeRestore;
$('restore-dialog').addEventListener('cancel',event=>{if(restoreBusy)event.preventDefault()});
$('restore-dialog').addEventListener('close',()=>{
 if(restoreBusy)return;restoreSequence++;restoreController?.abort();restoreReading=false;
 const ticket=restoreTicket;restoreTicket=null;if(ticket)api('restore.cancel',{ticket}).catch(()=>{})
});
$('restore-file').onchange=async()=>{
 const file=$('restore-file').files[0];if(!file)return;
 const previousTicket=restoreTicket;if(previousTicket)api('restore.cancel',{ticket:previousTicket}).catch(()=>{});
 const sequence=++restoreSequence;restoreController?.abort();restoreController=new AbortController();restoreTicket=null;restoreReading=true;
 $('restore-preview').hidden=true;$('restore-error').hidden=true;$('restore-pick').disabled=true;$('restore-confirm').disabled=true;$('restore-file-name').textContent=file.name;
 try{
  if(file.size>64*1024*1024)throw Error('64 MB 以下のバックアップを選んでください。');
  const response=await fetch(base+'restore-preview',{method:'POST',headers:{'Content-Type':'application/octet-stream','X-TaskMemo-Client':client,'X-TaskMemo-Generation':String(S.generation)},body:file,signal:restoreController.signal});
  const data=await response.json();if(sequence!==restoreSequence)return;if(!response.ok)throw Error(data.error||'バックアップを読み込めませんでした。');
  restoreTicket=data.ticket;$('restore-task-count').textContent=data.tasks;$('restore-note-count').textContent=data.notes;$('restore-preview').hidden=false;$('restore-confirm').disabled=false;
 }catch(error){if(sequence===restoreSequence&&error.name!=='AbortError')restoreError(error)}
 finally{if(sequence===restoreSequence){restoreReading=false;$('restore-pick').disabled=false}}
};
$('restore-confirm').onclick=async()=>{
 if(restoreBusy||restoreReading||!restoreTicket)return;
 // Block only this explicit replacement operation; normal editing has no extra gate.
 setRestoreBusy(true);$('restore-error').hidden=true;
 try{
  if(!await settledEdits()){setRestoreBusy(false);restoreError(Error('入力内容を保存してから、もう一度お試しください。'));return}
  S.restoring=true;await api('restore.commit',{ticket:restoreTicket});location.reload()
 }catch(error){S.restoring=false;setRestoreBusy(false);restoreError(error)}
};

