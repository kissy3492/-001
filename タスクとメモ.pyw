class LocalApp:
    def __init__(self, folder, port=0):
        self.folder = Path(folder)
        self.store = Store(self.folder / DB_NAME)
        self.holidays = HolidayCalendar(self.folder)
        self.store.conn.execute("CREATE TABLE IF NOT EXISTS preferences (key TEXT PRIMARY KEY, value TEXT NOT NULL)")
        self.store.conn.commit()
        self.guard = threading.RLock()
        self.token = secrets.token_urlsafe(32)
        self.clients = {}
        self.replies = {}
        self.sequences = {}
        self.generation = 0
        self.restore_pending = None
        self.last_restore = None
        self.last_seen = time.monotonic()
        self.started = self.last_seen
        self.empty_since = None
        self.loaded = False
        self.http = ThreadingHTTPServer(('127.0.0.1', port), Handler)
        self.http.app = self
        self.http.daemon_threads = False
        self.http.block_on_close = True
        self.origin = 'http://127.0.0.1:' + str(self.http.server_port)
        self.url = self.origin + '/' + self.token + '/'
        self.thread = None

    def start(self):
        self.thread = threading.Thread(target=self.http.serve_forever, daemon=True)
        self.thread.start()
        self.holidays.refresh()

    def stop(self):
        self.http.shutdown()
        self.http.server_close()
        if self.thread:
            self.thread.join(timeout=5)
        self.store.close()

    def preference(self, key, default=None):
        row = self.store.conn.execute('SELECT value FROM preferences WHERE key=?', (key,)).fetchone()
        return json.loads(row[0]) if row else default

    def put_preference(self, key, value):
        with self.store.conn:
            self.store.conn.execute('INSERT OR REPLACE INTO preferences(key,value) VALUES (?,?)',
                                    (key, json.dumps(value, ensure_ascii=False)))

    def edit_is_new(self, client, kind, data):
        key = (client, kind, data.get('id', 0))
        seq = int(data.get('seq', 0))
        return key, seq, seq >= self.sequences.get(key, -1)

    def save_note(self, client, data):
        key, seq, fresh = self.edit_is_new(client, 'note', data)
        ident = int(data['id'])
        old = self.store.note(ident)
        if not old or old['deleted']:
            raise ValueError('メモが見つかりません。')
        if fresh:
            row = self.store.save_note(ident, str(data.get('title', '')), str(data.get('body', '')))
            self.sequences[key] = seq
            return row
        return old

    def save_draft(self, client, data):
        key, seq, fresh = self.edit_is_new(client, 'draft', data)
        if fresh:
            values = {k: data.get(k, '') for k in ('title', 'detail', 'due_date', 'due_time', 'stage',
                                                  'waiting_kind', 'waiting_to', 'waiting_since', 'followup_date')}
            values['focus'] = bool(data.get('focus'))
            self.put_preference('draft', values)
            self.sequences[key] = seq

    def prepare_restore(self, content, client, generation):
        with self.guard:
            if generation != self.generation:
                raise ValueError('データが復元されました。画面を開き直してください。')
            if not content.startswith(b'SQLite format 3\0'):
                raise ValueError('このツールのバックアップを選んでください。')
            try:
                with tempfile.TemporaryDirectory() as temp:
                    path = Path(temp) / 'selected.sqlite3'
                    path.write_bytes(content)
                    snapshot = Store.read_backup(path)
            except (sqlite3.Error, json.JSONDecodeError) as exc:
                raise ValueError('バックアップを読み込めません。別の控えを選んでください。') from exc
            ticket = secrets.token_urlsafe(24)
            self.restore_pending = {'ticket':ticket, 'client':client, 'generation':self.generation,
                                    'snapshot':snapshot, 'expires':time.monotonic()+1800}
            return {'ticket':ticket,
                    'tasks':sum(not r['deleted'] for r in snapshot['tasks']),
                    'notes':sum(not r['deleted'] for r in snapshot['notes'])}

    def commit_restore(self, client, ticket):
        if self.last_restore and self.last_restore['client']==client and self.last_restore['ticket']==ticket:
            return self.last_restore['result']
        pending = self.restore_pending
        if not pending or pending['client']!=client or pending['ticket']!=ticket or pending['generation']!=self.generation or time.monotonic()>pending['expires']:
            raise ValueError('バックアップをもう一度選んでください。')
        name = '復元前の控え_' + dt.datetime.now().strftime('%Y%m%d_%H%M%S_%f') + '.sqlite3'
        self.store.backup(self.folder / name)
        self.store.restore_contents(pending['snapshot'])
        self.generation += 1
        self.replies.clear()
        self.sequences.clear()
        self.restore_pending = None
        result = {'restored':True, 'generation':self.generation, 'safety_copy':name}
        self.last_restore = {'client':client, 'ticket':ticket, 'result':result}
        return result

    def command(self, body):
        action = body.get('action')
        data = body.get('payload') or {}
        client = str(body.get('client', ''))[:100]
        request_id = str(body.get('request_id', ''))[:100]
        with self.guard:
            if action == 'restore.commit' and self.last_restore and self.last_restore['client']==client and self.last_restore['ticket']==data.get('ticket'):
                return self.last_restore['result']
            if action != 'init' and body.get('generation',0) != self.generation:
                raise ValueError('データが復元されました。画面を開き直してください。')
            if request_id and request_id in self.replies:
                table, ident, metadata = self.replies[request_id]
                row = self.store.task(ident) if table == 'tasks' else self.store.note(ident)
                replay = dict(metadata, row=self.ui_row(row))
                return replay
            if action == 'init':
                self.loaded = True
                result = dict(tasks=[self.ui_row(r) for r in self.store.tasks()],
                              notes=[self.ui_row(r) for r in self.store.notes()],
                              draft=self.preference('draft', {}), today=today(),
                              effects=self.preference('effects', True), generation=self.generation,
                              background=valid_background(self.preference('background')),
                              holidays=self.holidays.state())
            elif action == 'holiday.state':
                result = self.holidays.state(data.get('revision'))
            elif action == 'holiday.refresh':
                self.holidays.refresh(force=True)
                result = self.holidays.state(data.get('revision'))
            elif action == 'deleted.list':
                result = self.store.deleted_items(str(data.get('query','')),max(1,min(5000,int(data.get('limit',60)))))
            elif action == 'deleted.restore':
                table, ident = data.get('kind'), int(data['id'])
                if table not in ('tasks','notes'):
                    raise ValueError('戻す項目を選んでください。')
                row = self.store.task(ident) if table=='tasks' else self.store.note(ident)
                if row is None:
                    raise ValueError('項目が見つかりません。')
                self.store.delete(table,ident,False)
                result = dict(kind=table,row=self.store.task(ident) if table=='tasks' else self.store.note(ident))
            elif action == 'restore.cancel':
                if self.restore_pending and self.restore_pending['client']==client and self.restore_pending['ticket']==data.get('ticket'):
                    self.restore_pending = None
                result = {}
            elif action == 'restore.commit':
                result = self.commit_restore(client,str(data.get('ticket','')))
            elif action == 'task.add':
                ident = self.store.add_task(title=data.get('title', ''), detail=data.get('detail', ''),
                          due_date=data.get('due_date', ''), due_time=data.get('due_time', ''),
                          stage=data.get('stage') or '作業前', focus=bool(data.get('focus')),
                          waiting_kind=data.get('waiting_kind') or '依頼中',
                          waiting_to=data.get('waiting_to', ''), waiting_since=data.get('waiting_since', ''),
                          followup_date=data.get('followup_date', ''))
                result = dict(row=self.store.task(ident))
            elif action == 'task.update':
                ident = int(data['id'])
                before = self.store.task(ident)
                changes = dict(data.get('changes', {}))
                self.store.update_task(ident, **changes)
                result = dict(row=self.store.task(ident),
                              before={k:before[k] for k in ('stage','completed','waiting_since','due_date','due_time','focus_date','followup_date')})
            elif action == 'task.delete':
                ident = int(data['id'])
                self.store.delete('tasks', ident, bool(data.get('deleted', True)))
                result = dict(row=self.store.task(ident))
            elif action == 'note.add':
                ident = self.store.add_note()
                result = dict(row=self.store.note(ident))
            elif action == 'note.update':
                result = dict(row=self.save_note(client, data))
            elif action == 'note.pin':
                result = dict(row=self.store.pin_note(int(data['id']), bool(data.get('pinned'))))
            elif action == 'note.delete':
                ident = int(data['id'])
                self.store.delete('notes', ident, bool(data.get('deleted', True)))
                result = dict(row=self.store.note(ident))
            elif action == 'draft':
                self.save_draft(client, data)
                result = {}
            elif action == 'effects':
                value = bool(data.get('enabled', True))
                self.put_preference('effects', value)
                result = {'enabled': value}
            elif action == 'folder':
                if os.name == 'nt':
                    os.startfile(str(self.folder))
                result = {}
            elif action == 'background':
                value = data.get('value')
                if not isinstance(value, str) or value not in BACKGROUNDS:
                    raise ValueError('背景を選んでください。')
                self.put_preference('background', value)
                result = {'value': value}
            else:
                raise ValueError('操作を確認してください。')
            if 'row' in result:
                result['row'] = self.ui_row(result['row'])
            # Replay only operations that need it; retain IDs, never note bodies or init snapshots.
            if request_id and action in ('task.add', 'task.update', 'note.add'):
                self.replies[request_id] = ('tasks' if action.startswith('task.') else 'notes',
                                           result['row']['id'], {k:v for k,v in result.items() if k != 'row'})
                if len(self.replies) > 128:
                    self.replies.pop(next(iter(self.replies)))
            return result

    @staticmethod
    def ui_row(row):
        return {k:v for k,v in row.items() if k != 'search'} if row else None


class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    # Flush small localhost responses without TCP's packet-coalescing delay.
    disable_nagle_algorithm = True

    def log_message(self, fmt, *args):
        pass

    def reply(self, status, data, mime='application/json; charset=utf-8', headers=None):
        if not isinstance(data, bytes):
            data = json.dumps(data, ensure_ascii=False).encode('utf-8')
        self.send_response(status)
        self.send_header('Content-Type', mime)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', (headers or {}).get('Cache-Control', 'no-store'))
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('Content-Security-Policy', "default-src 'none'; script-src 'nonce-" + self.server.app.token + "'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'")
        for key, value in (headers or {}).items():
            if key != 'Cache-Control':
                self.send_header(key, value)
        self.end_headers()
        try:
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            pass

    def route(self):
        app = self.server.app
        self.connection.settimeout(10)
        if self.headers.get('Host') != urlsplit(app.origin).netloc:
            self.reply(403, {'error': '接続先を確認してください。'})
            return None
        origin = self.headers.get('Origin')
        if origin and origin != app.origin:
            self.reply(403, {'error': 'この画面から操作してください。'})
            return None
        path = urlsplit(self.path).path
        prefix = '/' + app.token + '/'
        if not path.startswith(prefix):
            self.reply(404, {'error': '見つかりません。'})
            return None
        return path[len(prefix):]

    def do_GET(self):
        route = self.route()
        if route is None:
            return
        app = self.server.app
        if route == '':
            with app.guard:
                app.last_seen = time.monotonic()
                app.empty_since = None
                background = valid_background(app.preference('background'))
            html = HTML.replace('__TOKEN__', app.token).replace('__BACKGROUND__', background).encode('utf-8')
            self.reply(200, html, 'text/html; charset=utf-8')
        elif route == 'ping':
            self.reply(200, {'ok': True, 'active': bool(app.clients)})
        elif route == 'art' or route.startswith('art/'):
            key = route[4:] if route.startswith('art/') else 'library'
            if key not in ARTWORK:
                self.reply(404, {'error': '背景が見つかりません。'})
            else:
                self.reply(200, ARTWORK[key], 'image/webp', {'Cache-Control':'private, max-age=31536000, immutable'})
        elif route == 'backup':
            try:
                with app.guard, tempfile.TemporaryDirectory() as temp:
                    file = Path(temp) / 'backup.sqlite3'
                    app.store.backup(file)
                    content = file.read_bytes()
                from urllib.parse import quote
                filename = 'タスクとメモ_控え_' + dt.datetime.now().strftime('%Y%m%d_%H%M%S') + '.sqlite3'
                self.reply(200, content, 'application/octet-stream',
                           {'Content-Disposition': "attachment; filename=task-memo.sqlite3; filename*=UTF-8''" + quote(filename)})
            except (OSError, sqlite3.Error, ValueError):
                self.reply(500, {'error': 'バックアップを作成できませんでした。'})
        else:
            self.reply(404, {'error': '見つかりません。'})

    def do_POST(self):
        route = self.route()
        if route is None:
            return
        app = self.server.app
        try:
            length = int(self.headers.get('Content-Length', '0'))
            limit = HolidayCalendar.MAX_BYTES if route=='holiday-import' else (64 if route=='restore-preview' else 16) * 1024 * 1024
            if length <= 0 or length > limit:
                self.reply(413, {'error': '一度に保存する内容が大きすぎます。'})
                return
            if route == 'restore-preview':
                result = app.prepare_restore(self.rfile.read(length),self.headers.get('X-TaskMemo-Client','')[:100],
                                             int(self.headers.get('X-TaskMemo-Generation','0')))
                self.reply(200,result)
                return
            if route == 'holiday-import':
                result = app.holidays.import_csv(self.rfile.read(length))
                self.reply(200, result)
                return
            body = json.loads(self.rfile.read(length).decode('utf-8'))
            if not isinstance(body, dict):
                raise ValueError('操作を確認してください。')
            with app.guard:
                client = str(body.get('client', ''))[:100]
                app.last_seen = time.monotonic()
                if route == 'pulse':
                    app.clients[client] = app.last_seen
                    app.empty_since = None
                    app.holidays.refresh()
                    result = {'today': today(), 'generation':app.generation,
                              'holidays':app.holidays.state(body.get('holiday_revision'))}
                elif route == 'leave':
                    fresh = body.get('generation',0)==app.generation
                    if fresh and body.get('note'):
                        app.save_note(client, body['note'])
                    if fresh and body.get('draft'):
                        app.save_draft(client, body['draft'])
                    app.clients.pop(client, None)
                    if not app.clients:
                        app.empty_since = time.monotonic()
                    result = {}
                elif route == 'api':
                    result = app.command(body)
                else:
                    self.reply(404, {'error': '見つかりません。'})
                    return
            self.reply(200, result)
        except (ValueError, KeyError, TypeError) as exc:
            self.reply(400, {'error': str(exc) if isinstance(exc, ValueError) else '入力内容を確認してください。'})
        except (OSError, sqlite3.Error):
            self.reply(500, {'error': '保存できませんでした。空き容量と保存先を確認してください。'})


def find_edge():
    paths = []
    if os.name == 'nt':
        for name in ('PROGRAMFILES(X86)', 'PROGRAMFILES', 'LOCALAPPDATA'):
            base = os.environ.get(name)
            if base:
                paths.append(Path(base) / 'Microsoft/Edge/Application/msedge.exe')
        try:
            import winreg
            for hive in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
                try:
                    with winreg.OpenKey(hive, r'SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\msedge.exe') as key:
                        paths.append(Path(winreg.QueryValueEx(key, '')[0]))
                except OSError:
                    pass
        except ImportError:
            pass
    executable = shutil.which('msedge') or shutil.which('microsoft-edge')
    if executable:
        paths.append(Path(executable))
    return next((str(p) for p in paths if p.is_file()), None)


def launch_edge(edge, url, folder):
    import hashlib
    key = hashlib.sha256(str(folder).encode('utf-8')).hexdigest()[:16]
    profile_base = Path(os.environ.get('LOCALAPPDATA') or str(folder)) / 'TaskMemo' / key
    args = [edge, '--app=' + url, '--window-size=1280,760', '--no-first-run',
            '--no-default-browser-check', '--force-dark-mode', '--disable-background-mode', '--user-data-dir=' + str(profile_base)]
    return subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def show_error(message):
    import tkinter as tk
    from tkinter import messagebox
    root = tk.Tk()
    root.withdraw()
    messagebox.showerror(APP_NAME, message, parent=root)
    root.destroy()


def main():
    folder = Path(__file__).resolve().parent
    lock_path = folder / '.タスクとメモ.lock'
    lock = app = None
    try:
        edge = find_edge()
        if not edge:
            show_error('Microsoft Edge が見つかりません。Edge がインストールされた Windows で開いてください。')
            return
        try:
            lock = SingleInstance(lock_path)
        except RuntimeError as exc:
            try:
                from urllib.request import urlopen
                with open(lock_path, 'rb') as file:
                    file.seek(1)
                    previous = json.loads(file.read().decode('utf-8'))
                old_url = previous['url']
                parsed = urlsplit(old_url)
                if parsed.scheme != 'http' or parsed.hostname != '127.0.0.1':
                    raise ValueError
                with urlopen(old_url + 'ping', timeout=2) as response:
                    state = json.loads(response.read())
                    if not state.get('ok'):
                        raise ValueError
                if state.get('active'):
                    show_error(str(exc))
                else:
                    launch_edge(edge, old_url, folder)
            except Exception:
                show_error(str(exc))
            return
        app = LocalApp(folder)
        app.start()
        lock.file.truncate(1)
        lock.file.write(json.dumps({'url': app.url}).encode('utf-8'))
        lock.file.flush()
        process = launch_edge(edge, app.url, folder)
        last_tick = time.monotonic()
        while True:
            time.sleep(1)
            now = time.monotonic()
            with app.guard:
                if now - last_tick > 30:
                    app.last_seen = now
                    app.empty_since = None
                last_tick = now
                if app.empty_since is not None and now - app.empty_since > 10:
                    break
                if not app.loaded and now - app.started > 90:
                    show_error('画面を開けませんでした。Edge を閉じて、もう一度開いてください。')
                    break
                if app.loaded and process.poll() is not None and now - app.last_seen > 90:
                    break
                if app.loaded and now - app.last_seen > 900:
                    break
    except (OSError, sqlite3.Error, RuntimeError) as exc:
        show_error('起動できませんでした。保存先を確認してください。\n\n' + str(exc))
    finally:
        if app:
            app.stop()
        if lock:
            lock.file.truncate(1)
            lock.close()


if __name__ == '__main__':
    main()
